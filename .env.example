# Copy this file to .env and populate the four REQUIRED secrets below.
# Use hex-only secrets (URL-safe database password); KEEP existing secrets on upgrade.
# PowerShell 7: [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLowerInvariant()
# Linux: openssl rand -hex 32
DB_PASSWORD=
DB_ROOT_PASSWORD=
APP_SECRET=
PREFERENCES_KEY=

# Browser-facing public URL; no trailing slash. Adjust BOTH when changing hostname.
PUBLIC_URL=http://localhost:8080
PUBLIC_HOST=localhost:8080
# Local-only by default; 0.0.0.0 exposes Classement on all host interfaces.
WEB_BIND=127.0.0.1
WEB_PORT=8080
MAIL_UI_PORT=8025

# Source branches or tags. Bump UPSTREAM_REFRESH (or --no-cache) for fresh Git fetches.
# Do not blindly update both sides without reviewing the upstream changes.
CLIENT_REPO=https://github.com/Zefling/classement-client.git
CLIENT_REF=master
SERVER_REPO=https://github.com/Zefling/classement-server.git
SERVER_REF=main
UPSTREAM_REFRESH=initial

# Local Mailpit receives signup/confirmation/reset messages; use real SMTP when public.
MAILER_DSN=smtp://mailpit:1025
# Upstream uses no-reply@ikilote.net for signup/reset mail; no APP_FROM_EMAIL override exists.
APP_CONTACT_EMAIL=admin@example.test
CORS_ALLOW_ORIGIN=^$
APP_CONTACT_OBJECT=Classement: Contact message

# Only configure this for actual trusted reverse proxy IP(s)/CIDR(s).
# Immediate upstream IP/CIDR of Caddy as seen by Apache. Required for HTTPS link generation.
# Leave this disabled for localhost. On Docker bridge, find the gateway with:
# docker network inspect classement_default --format '{{(index .IPAM.Config 0).Gateway}}'
# Example ONLY: APACHE_TRUSTED_PROXY_CIDR=172.19.0.1/32
APACHE_TRUSTED_PROXY_CIDR=127.0.0.1/32
# Set Symfony trusted proxy to the same actual trusted peer(s) on HTTPS deployment.
SYMFONY_TRUSTED_PROXIES=
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-port

# Optional third-party features; empty means unconfigured.
TMDB_API_KEY=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_FACEBOOK_ID=
OAUTH_FACEBOOK_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
